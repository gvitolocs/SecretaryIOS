#!/usr/bin/env bash
# The fast local check, run in your worktree before a commit: only what the change touched, capped. docs/ci/SHIFT-LEFT.md.
# Usage: scripts/check-fast [--base REF] [--no-build] [--proofs [--mutants] [--all-proofs]] [--merge-gate]
# diffgate, rustfmt, Clippy and unit tests of the touched crates, shellcheck/actionlint/gitleaks when installed, the proof
# inventory. Verus runs on GitHub; --proofs runs the affected proofs here.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
# One shared Cargo target for every worktree (the same one LucinaOS uses), so the loop adds no new large target directories on
# nezopt. The launcher itself builds apart, in its own small target, because LucinaOS's launcher has the same package name.
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-$HOME/.cache/lucina-check-target}
export LUCINA_CI_CPU_QUOTA=${LUCINA_CI_CPU_QUOTA:-400%}
free=$(df --output=avail -BG "$HOME" | tail -1 | tr -dc 0-9)
[ "$free" -ge 20 ] || { echo "check-fast: only ${free} GiB free; refusing to build" >&2; exit 2; }
tool=${SECRETARY_CI_TOOL_TARGET:-$HOME/.cache/secretary-ci-tool}
# The tool is built apart from where it is installed, and reaches $tool/release/lucina-ci only through rename(2): a
# check-fast that is already running was started from that name, and a build that wrote it in place would take it away from
# under the steps it starts (GATE-06: "Failed to find executable .../release/lucina-ci (deleted)", merge job
# job_fc4fabf8e6fe). The copy is a new file, so a run whose build died leaves the installed tool exactly as it was and no
# half-written one behind. The name is not keyed by the source it was built from: a merge and its own lane build the same
# source and would still replace each other, and the run in flight is what has to survive either way — it copies the binary
# it started from into its own per-run directory and starts every step from that copy (cmd_check_fast, src/main.rs).
build=${SECRETARY_CI_TOOL_BUILD:-${tool}-build}
CARGO_TARGET_DIR=$build cargo build --quiet --release --locked --manifest-path "$root/tools/ci/lucina-ci/Cargo.toml"
mkdir -p "$tool/release"
tmp=$tool/release/lucina-ci.tmp.$$
trap 'rm -f "$tmp"' EXIT
# GATE-16: the temp name is under a directory other processes may be able to write, and a symlink planted at it must not be
# followed by the copy. It is removed first, `install` (which unlinks an existing destination and writes a new file, mode
# 0755) makes the file, and the install refuses to go on if what stands there is not a plain file.
rm -f "$tmp"
install -m 0755 "$build/release/lucina-ci" "$tmp"
if [ -L "$tmp" ] || [ ! -f "$tmp" ]; then
    echo "check-fast: $tmp is not a plain file after the install; refusing to move it onto the tool" >&2
    exit 2
fi
mv -fT "$tmp" "$tool/release/lucina-ci"
exec "$tool/release/lucina-ci" check-fast "$@"
