#!/usr/bin/env bash
# The fast local check, run in your worktree before a commit: only what the change touched, capped. docs/ci/SHIFT-LEFT.md.
# Usage: scripts/check-fast [--base REF] [--no-build] [--proofs [--mutants] [--all-proofs]] [--merge-gate]
# diffgate, rustfmt, Clippy and unit tests of the touched crates, shellcheck/actionlint/gitleaks when installed, the proof
# inventory. Verus runs on GitHub; --proofs runs the affected proofs here.
set -euo pipefail
root=$(cd "$(dirname "$0")/.." && pwd)
# The build queue (HOST-11). Every check-fast runs as ONE job of the queue's `long` class, so that several of them at once
# cannot stack up their steps outside the queue's slots (nezopt ran out of memory on 80 step scopes from concurrent runs). The
# launcher always re-runs itself through `bq run --class long`, and the job's own call (the same launcher, marked with the
# first argument --queued-by-bq, which only this launcher puts there and which is ignored unless bq really holds a slot for the run)
# does the work. No environment variable decides whether a
# run is queued: bq itself runs a nested call of the SAME class right there, with no ticket and no second slot, and queues a
# nested call of another class in its own pool (docs/ci/BQ.md, "Never nest"); it believes the BQ_SLOT / BQ_SLOT_PID mark only
# against its own slot record (tools/bq/src/main.rs, ancestor_slot_class), and a launcher that read the mark itself would be
# believing a caller's word on a weaker test. BQ_* names also reach the job unscrubbed (tools/bq/src/main.rs:1794-1799; the
# scrub list is :133), so keying on them would let any caller skip the queue.
# A start inside a bq slot of a class other than long or gate is refused (bq_foreign_class below); that refusal also keys on BQ_SLOT,
# BQ_SLOT_PID and the slot record, so a caller who clears BQ_SLOT only reverts to queueing, never to a skip.
# The queue is looked up in the home directory of the real uid from the passwd entry, never in $HOME (a caller's HOME decides
# nothing here): $QHOME/.local/bin/bq first, which must print our usage or the check FAILS (exit 2) and runs nothing; a `bq`
# on PATH only when that file does not exist, and only if it prints our usage (PATH holds the Google Cloud SDK's BigQuery
# `/usr/bin/bq` on GitHub's runners). A home that cannot be resolved is a refusal (exit 2), not "no queue here". Only a host with
# neither (GitHub's runners and any host without the queue binary) runs the check directly, and says so first, on stderr.
# The next line is the only one a test replaces (with a fixed home, in a copy of this script); nothing in the environment can.
qhome=$(
    export PATH=/usr/bin:/bin
    getent passwd "$(id -ru)" | cut -d: -f6
) || qhome=""
if [ -z "$qhome" ] || [ ! -d "$qhome" ]; then
    echo "check-fast: cannot resolve the home directory of this uid from the passwd entry; refusing, since the build queue is looked up there and nowhere else" >&2
    exit 2
fi
bq_is_ours() {
    local bq_usage
    [ -x "$1" ] || return 1
    bq_usage=$(timeout 5 "$1" </dev/null 2>&1 || true)
    # Our queue's usage offers `--class short|long|proof` and every option the call below passes; a queue that does not is
    # not one this launcher can call as written, and is not taken.
    case "$bq_usage" in
        *'--class short|long|proof'*) ;;
        *) return 1 ;;
    esac
    case "$bq_usage" in
        *'--max-wait'*) ;;
        *) return 1 ;;
    esac
    case "$bq_usage" in
        *'--priority'*) ;;
        *) return 1 ;;
    esac
    case "$bq_usage" in
        *'--keep-env'*) ;;
        *) return 1 ;;
    esac
    return 0
}
# 0: found, printed. 1: no bq of ours anywhere. 2: the bq in the home directory exists and is not ours.
bq_find() {
    local home_bq=$qhome/.local/bin/bq c
    if [ -e "$home_bq" ] || [ -L "$home_bq" ]; then
        if bq_is_ours "$home_bq"; then
            printf '%s\n' "$home_bq"
            return 0
        fi
        return 2
    fi
    c=$(command -v bq 2>/dev/null || true)
    if [ -n "$c" ] && bq_is_ours "$c"; then
        printf '%s\n' "$c"
        return 0
    fi
    return 1
}
# A typed --queued-by-bq is ignored unless bq really holds a slot for this run: the inner run believes it only as bq believes its
# own mark (tools/bq/src/main.rs, ancestor_slot_class): BQ_SLOT and BQ_SLOT_PID are set, BQ_SLOT_PID is a live ancestor of this
# shell, and the slot's meta file in the queue's state directory (<passwd home>/.cache/bq, never $HOME or BQ_DIR) names
# pid=<BQ_SLOT_PID> and a class bq knows. Otherwise the argument is dropped and the run queues like any other.
# Coupling: a nested check-fast is believed only if bq's state directory equals <passwd home>/.cache/bq. A bq run with BQ_DIR set,
# or with a $HOME different from the passwd home, writes its slot records elsewhere, so a genuine nested run re-queues and stops with
# exit 2 (queued twice, no slot record): it fails closed, never runs unqueued, and costs only availability.
bq_slot_is_real() {
    local spid=${BQ_SLOT_PID:-} p=$$ stat rest n=0 meta
    slot_class=
    [ -n "${BQ_SLOT:-}" ] || return 1
    case "$BQ_SLOT" in */* | .*) return 1 ;; esac
    case "$spid" in '' | *[!0-9]*) return 1 ;; esac
    [ "$spid" -gt 1 ] || return 1
    [ -d "/proc/$spid" ] || return 1
    meta=$qhome/.cache/bq/$BQ_SLOT.meta
    [ -f "$meta" ] || return 1
    grep -qx "pid=$spid" "$meta" || return 1
    # With an argument the class need not be one bq knows: the caller reads it from slot_class and decides.
    if [ -z "${1:-}" ]; then grep -qxE 'class=(gate|short|long|proof|node)' "$meta" || return 1; fi
    slot_class=$(sed -n 's/^class=//p' "$meta" | head -n 1)
    while [ "$p" -gt 1 ] && [ "$n" -lt 64 ]; do
        [ "$p" = "$spid" ] && return 0
        stat=$(<"/proc/$p/stat") 2>/dev/null || return 1
        rest=${stat##*) } # after the command name, which may hold spaces and parentheses: "S ppid ..."
        rest=${rest#* }
        p=${rest%% *}
        case "$p" in '' | *[!0-9]*) return 1 ;; esac
        n=$((n + 1))
    done
    return 1
}
# A start inside a slot that bq really holds for a class other than long or gate is refused at once. check-fast queues itself in
# the long class: started inside a short, proof or node slot it would wait for a long slot while keeping the first one, and
# the jobs queued behind that slot would wait for it. A record with any other class is treated the same way. A hand-set BQ_SLOT
# A failed check exits 1 (lucina-ci check-fast); this refusal exits 2 and says no check ran. It keys on BQ_SLOT, BQ_SLOT_PID and the
# slot record, so a caller who clears BQ_SLOT only goes back to queueing, never to a skip.
bq_foreign_class() {
    bq_slot_is_real any || return 1
    case "$slot_class" in long | gate) return 1 ;; esac
    return 0
}
if bq_foreign_class; then
    echo "check-fast: refused, no check ran (exit 2, not a result about the change): it was started inside a bq slot of class $slot_class. Run scripts/check-fast directly; it queues itself in the long class." >&2
    exit 2
fi
# The argument carries how many times this run has been through the queue (--queued-by-bq=N; a typed bare --queued-by-bq is 0). A
# run that still finds no real slot after being queued twice stops (exit 2) instead of going round again: a queue whose state
# directory is not the one looked up here would otherwise send the launcher through it for ever.
queued=0
depth=0
case "${1:-}" in
    --queued-by-bq=[0-9]*)
        depth=${1#--queued-by-bq=}
        shift
        case "$depth" in *[!0-9]*) depth=0 ;; esac
        if bq_slot_is_real; then queued=1; fi
        ;;
    --queued-by-bq)
        shift
        if bq_slot_is_real; then queued=1; fi
        ;;
esac
if [ "$queued" = 0 ] && [ "$depth" -ge 2 ]; then
    echo "check-fast: queued twice and bq holds no slot for this run (no $qhome/.cache/bq/<slot>.meta naming this run); refusing to go round again" >&2
    exit 2
fi
if [ "$queued" = 0 ]; then
    bqrc=0
    bqbin=$(bq_find) || bqrc=$?
    if [ "$bqrc" -eq 2 ]; then
        echo "check-fast: $qhome/.local/bin/bq exists but is not our build queue (its usage does not offer --class short|long|proof, --max-wait, --priority and --keep-env); refusing to run without the queue" >&2
        exit 2
    fi
    if [ "$bqrc" -eq 0 ]; then
        prio=normal
        # 3600 s for a plain run. The merge gate runs under the outer limit of its pipeline gate (.lucina/pipeline.toml), which counts
        # the wait for the one gate slot, so it waits at most BQ_WAIT_ALLOWANCE_S (tools/ci/lucina-ci/src/budget.rs) and then fails at
        # once with bq's own message, instead of being killed by the clock halfway through its steps (GATE-19). A test ties the two.
        maxwait=3600
        for arg in "$@"; do
            if [ "$arg" = "--merge-gate" ]; then
                prio=gate
                maxwait=300
            fi
        done
        self=$(cd "$(dirname "$0")" && pwd)/$(basename "$0")
        exec "$bqbin" run --class long --priority "$prio" --max-wait "$maxwait" --keep-env GIT_CONFIG_COUNT \
            --who "check-fast:$(basename "$root")" -- "$self" "--queued-by-bq=$((depth + 1))" "$@"
    fi
    # On stderr, so that the stdout of a run is still the check's own bytes; it is the first line the run prints.
    echo "check-fast: no bq on this host; running without the queue" >&2
fi
# One Cargo target PER WORKTREE, all under one cache root. Cargo gives a workspace member the same artifact hash in every worktree, so a
# target shared by worktrees on different commits let one worktree's build make cargo judge another worktree's sources fresh: a check
# could pass or fail on code that was not in its worktree (GATE-24; LucinaOS fixed the same thing on 2026-11-11). The first check in a
# new worktree compiles its dependencies once. The launcher itself still builds apart, in its own small target, because LucinaOS's
# launcher has the same package name. This repo has no sweeper: LucinaOS's check-fast sweeps the whole cache root (in-use aware),
# which includes these wt-* children.
cache_root=${LUCINA_CHECK_CACHE:-$qhome/.cache/lucina-check-target}
wt_id=wt-$(printf '%s' "$root" | sha1sum | cut -c1-10)
# The agent runner gives every agent in a worktree one shared Cargo target for its plain builds and names it in
# LUCINA_AGENT_SHARED_TARGET. A check run by such an agent inherits it as CARGO_TARGET_DIR; it is dropped here, so the check builds in
# its own per-worktree target below and does not warn about the inherited one. The variable can be set by anyone running as this user
# and can hold any path: all it can do is make this script use its OWN target instead of the inherited one, never someone else's.
# Only a path that resolves to the same place as the inherited target counts; a different inherited target is judged as before, and
# the merge gate's landing target must never be named by the runner. Dropping the target costs one cold build in a worktree
# target (in a repo with no sweeper that folder stays until the sweeper exists, GATE-28).
# A path is resolved as bq does: readlink -f, and when that fails (a missing parent folder, as on a fresh cache) the parent is
# resolved and the last name appended; two missing-parent paths that are the same string are equal. An empty path is never resolved
# (readlink -f "" answers the current folder).
# A path spelled with .. through a missing ancestor is left as written, so it does not match another spelling of the same place: the harmless
# direction (the inherited target is kept and warned about), so it is not normalised by hand.
agent_resolve() {
    local p=$1 r d
    [ -n "$p" ] || return 1
    case "$p" in /*) ;; *) p=$PWD/$p ;; esac
    if r=$(readlink -f "$p" 2> /dev/null) && [ -n "$r" ]; then
        printf '%s\n' "$r"
        return 0
    fi
    d=$(dirname "$p")
    if r=$(readlink -f "$d" 2> /dev/null) && [ -n "$r" ]; then
        d=$r
    fi
    printf '%s/%s\n' "${d%/}" "$(basename "$p")"
}
agent_shared=0
if [ -n "${LUCINA_AGENT_SHARED_TARGET:-}" ] && [ -n "${CARGO_TARGET_DIR:-}" ]; then
    shared_real=$(agent_resolve "$LUCINA_AGENT_SHARED_TARGET" || true)
    inherited_real=$(agent_resolve "$CARGO_TARGET_DIR" || true)
    if [ -n "$shared_real" ] && [ "$shared_real" = "$inherited_real" ]; then
        unset CARGO_TARGET_DIR
        agent_shared=1
    fi
fi
if [ -n "${CARGO_TARGET_DIR:-}" ] && [ "${CARGO_TARGET_DIR#"$cache_root"/}" = "$CARGO_TARGET_DIR" ] && [ "${LUCINA_CHECK_ALLOW_TARGET:-}" != 1 ]; then
    echo "check-fast: warning: CARGO_TARGET_DIR=$CARGO_TARGET_DIR (inherited) is outside $cache_root; a target shared with other worktrees can hold another commit's artifacts (set LUCINA_CHECK_ALLOW_TARGET=1 to silence this)." >&2
fi
export CARGO_TARGET_DIR=${CARGO_TARGET_DIR:-$cache_root/$wt_id}
mkdir -p "$CARGO_TARGET_DIR"
touch "$CARGO_TARGET_DIR/.last-used"
if [ "$agent_shared" = 1 ]; then
    echo "check-fast: the agent's shared target is not used; building in $CARGO_TARGET_DIR" >&2
fi
# No incremental compilation: the caches rarely get reused and were nearly half the old shared target's size (40 of 89 GiB on 2026-11-11,
# when nezopt's disk ran short). A caller that sets CARGO_INCREMENTAL keeps its value.
export CARGO_INCREMENTAL=${CARGO_INCREMENTAL:-0}
export LUCINA_CI_CPU_QUOTA=${LUCINA_CI_CPU_QUOTA:-400%}
free=$(df --output=avail -BG "$qhome" | tail -1 | tr -dc 0-9)
[ "$free" -ge 20 ] || { echo "check-fast: only ${free} GiB free; refusing to build" >&2; exit 2; }
tool=${SECRETARY_CI_TOOL_TARGET:-$qhome/.cache/secretary-ci-tool}
# The tool is built apart from where it is installed, and reaches $tool/release/lucina-ci only through rename(2): a
# check-fast that is already running was started from that name, and a build that wrote it in place would take it away from
# under the steps it starts (GATE-06: "Failed to find executable .../release/lucina-ci (deleted)", merge job
# job_fc4fabf8e6fe). The copy is a new file, so a run whose build died leaves the installed tool exactly as it was and no
# half-written one behind. The name is not keyed by the source it was built from: a merge and its own lane build the same
# source and would still replace each other, and the run in flight is what has to survive either way — it copies the binary
# it started from into its own per-run directory and starts every step from that copy (cmd_check_fast, src/main.rs).
build=${SECRETARY_CI_TOOL_BUILD:-${tool}-build}
# GATE-16: the directories the tool is built in, installed into and run from are chosen by the environment, and the launcher
# execs what it finds there. Each must resolve to a directory under the home directory of this uid (the passwd one, as for the
# queue), owned by this user, and writable by no one else; anything else is a refusal (exit 2) before a byte is written there.
# The directories are made with umask 022, so a fresh one passes; one made earlier with a looser mode is refused with the
# command that fixes it.
tool_dir_ok() {
    local d=$1 real home_real owner mode
    real=$(cd "$d" 2>/dev/null && pwd -P) || {
        echo "check-fast: $d is not a directory" >&2
        return 1
    }
    home_real=$(cd "$qhome" && pwd -P)
    case "$real/" in
        "$home_real"/*) ;;
        *)
            echo "check-fast: $d (resolves to $real) is not under the home directory $home_real; refusing to install the tool there or run it from there" >&2
            return 1
            ;;
    esac
    read -r owner mode < <(stat -c '%u %a' "$real")
    if [ "$owner" != "$(id -u)" ]; then
        echo "check-fast: $d is owned by uid $owner, not by this user; refusing to install the tool there or run it from there" >&2
        return 1
    fi
    if [ $((8#$mode & 8#022)) -ne 0 ]; then
        echo "check-fast: $d is writable by group or others (mode $mode); refusing to install the tool there or run it from there. Fix: chmod go-w \"$real\"" >&2
        return 1
    fi
}
# Nothing is made outside the home: the names are checked as written first, the directories as they resolve after.
for d in "$tool" "$build"; do
    case "$d/" in
        "$qhome"/*) ;;
        *)
            echo "check-fast: $d is not under the home directory $qhome; refusing to install the tool there or run it from there" >&2
            exit 2
            ;;
    esac
done
(
    umask 022
    mkdir -p "$tool/release" "$build"
)
for d in "$tool" "$tool/release" "$build"; do
    tool_dir_ok "$d" || exit 2
done
CARGO_TARGET_DIR=$build cargo build --quiet --release --locked --manifest-path "$root/tools/ci/lucina-ci/Cargo.toml"
# The temp name is made by mktemp (a name nobody can predict, O_EXCL, mode 0600) in the checked directory: nothing is planted
# there ahead of the copy, and the copy is never written through a link. If what stands there is not a plain file the install
# stops.
tmp=$(mktemp "$tool/release/lucina-ci.tmp.XXXXXX")
trap 'rm -f "$tmp"' EXIT
cp "$build/release/lucina-ci" "$tmp"
chmod 0755 "$tmp"
if [ -L "$tmp" ] || [ ! -f "$tmp" ]; then
    echo "check-fast: $tmp is not a plain file after the copy; refusing to move it onto the tool" >&2
    exit 2
fi
mv -fT "$tmp" "$tool/release/lucina-ci"
exec "$tool/release/lucina-ci" check-fast "$@"
