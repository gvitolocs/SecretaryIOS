{
  "name": "@secretary/lucina-stage",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "three.js stage with a procedurally animated Lucina avatar that listens and talks (Secretary web + iOS WKWebView).",
  "main": "./dist/lucina-stage.js",
  "module": "./dist/lucina-stage.js",
  "types": "./dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lucina-stage.js"
    },
    "./standalone": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/lucina-stage.standalone.js"
    },
    "./source": "./src/index.ts"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build && vite build --mode standalone && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "size": "node scripts/size.mjs"
  },
  "dependencies": {
    "three": "0.186.1"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.22.2"
  }
}
