{
  "note": "Golden transcripts for the Secretary chat turn, replayed against the fake DeepSeek. 'calls' is the sequence of prompt kinds the turn sent (intent, plan, reply, agent); 'tools' the executed tools recorded in the timeline. Synthetic messages only; real owner messages stay on nezopt (port plan §4).",
  "cases": [
    {
      "name": "greeting goes to the chat reply",
      "planner": "json",
      "message": "ciao Lucina",
      "rules": [
        {
          "kind": "intent",
          "content": "{\"intent\":\"social_greeting\",\"confidence\":0.97,\"reply_mode\":\"chat\"}"
        },
        {
          "kind": "reply",
          "content": "Ciao Giuseppe!"
        }
      ],
      "expect": {
        "action": "reply",
        "reply": "Ciao Giuseppe!",
        "calls": [
          "intent",
          "reply"
        ],
        "tools": []
      }
    },
    {
      "name": "low confidence uses the full JSON plan",
      "planner": "json",
      "message": "mi spieghi la differenza tra TCP e UDP?",
      "rules": [
        {
          "kind": "intent",
          "content": "{\"intent\":\"unknown\",\"confidence\":0.3,\"reply_mode\":\"full_plan\"}"
        },
        {
          "kind": "plan",
          "content": "{\"action\":\"reply\",\"text\":\"TCP garantisce consegna e ordine; UDP no, ma è più leggero.\"}"
        }
      ],
      "expect": {
        "action": "reply",
        "reply": "TCP garantisce consegna e ordine; UDP no, ma è più leggero.",
        "calls": [
          "intent",
          "plan"
        ],
        "tools": []
      }
    },
    {
      "name": "planner reply plus reminder heuristic becomes schedule_reminder",
      "planner": "json",
      "message": "ricordami alle 23:59 di spegnere il forno",
      "rules": [
        {
          "kind": "intent",
          "content": "{\"intent\":\"unknown\",\"confidence\":0.4}"
        },
        {
          "kind": "plan",
          "content": "{\"action\":\"reply\",\"text\":\"Va bene\"}"
        }
      ],
      "expect": {
        "action": "schedule_reminder",
        "replyStartsWith": "Reminder set for ",
        "reminderText": "Va bene",
        "calls": [
          "intent",
          "plan"
        ],
        "tools": []
      },
      "parityNote": "Node parity (planResponse post-processing): the planner's reply text becomes the reminder text when the reminder heuristic overrides a reply plan. Kept on purpose; fix in both runtimes together."
    },
    {
      "name": "unsupported tool says so",
      "planner": "json",
      "message": "fammi un grafico del patrimonio",
      "rules": [
        {
          "kind": "intent",
          "content": "{\"intent\":\"graph_task\",\"confidence\":0.9,\"reply_mode\":\"full_plan\"}"
        },
        {
          "kind": "plan",
          "content": "{\"action\":\"graph_task\",\"prompt\":\"patrimony trend\",\"spreadsheetName\":\"patrimony.xlsx\"}"
        }
      ],
      "expect": {
        "action": "graph_task",
        "replyStartsWith": "The graph cannot start",
        "calls": [
          "intent",
          "plan"
        ],
        "tools": []
      }
    },
    {
      "name": "tools mode: weather",
      "planner": "tools",
      "message": "che tempo fa domani a Copenhagen?",
      "rules": [
        {
          "kind": "agent",
          "afterTool": false,
          "toolCalls": [
            {
              "name": "weather",
              "arguments": {
                "location": "Copenhagen",
                "days": 2
              }
            }
          ]
        },
        {
          "kind": "agent",
          "afterTool": true,
          "content": "Domani pioggia leggera, 5-10 °C."
        }
      ],
      "expect": {
        "action": "reply",
        "reply": "Domani pioggia leggera, 5-10 °C.",
        "calls": [
          "agent",
          "agent"
        ],
        "tools": [
          "weather"
        ]
      }
    },
    {
      "name": "tools mode: calculator",
      "planner": "tools",
      "message": "quanto fa 17% di 230?",
      "rules": [
        {
          "kind": "agent",
          "afterTool": false,
          "toolCalls": [
            {
              "name": "calculator",
              "arguments": {
                "expression": "17% * 230"
              }
            }
          ]
        },
        {
          "kind": "agent",
          "afterTool": true,
          "content": "Fa 39,1."
        }
      ],
      "expect": {
        "action": "reply",
        "reply": "Fa 39,1.",
        "calls": [
          "agent",
          "agent"
        ],
        "tools": [
          "calculator"
        ]
      }
    },
    {
      "name": "tools mode: reminder via tool",
      "planner": "tools",
      "message": "ricordami tra 2 ore di stendere",
      "rules": [
        {
          "kind": "agent",
          "afterTool": false,
          "toolCalls": [
            {
              "name": "reminders",
              "arguments": {
                "action": "create",
                "naturalText": "ricordami tra 2 ore di stendere"
              }
            }
          ]
        },
        {
          "kind": "agent",
          "afterTool": true,
          "content": "Fatto: te lo ricordo tra due ore."
        }
      ],
      "expect": {
        "action": "schedule_reminder",
        "reply": "Fatto: te lo ricordo tra due ore.",
        "reminderText": "stendere",
        "calls": [
          "agent",
          "agent"
        ],
        "tools": [
          "reminders"
        ]
      }
    },
    {
      "name": "tools mode: a refused tool error goes back to the model",
      "planner": "tools",
      "message": "converti 5 parsec in metri",
      "rules": [
        {
          "kind": "agent",
          "afterTool": false,
          "toolCalls": [
            {
              "name": "unit_convert",
              "arguments": {
                "value": 5,
                "from": "parsec",
                "to": "m"
              }
            }
          ]
        },
        {
          "kind": "agent",
          "afterTool": true,
          "content": "Non conosco l'unità parsec."
        }
      ],
      "expect": {
        "action": "reply",
        "reply": "Non conosco l'unità parsec.",
        "calls": [
          "agent",
          "agent"
        ],
        "tools": [
          "unit_convert"
        ],
        "toolOk": [
          false
        ]
      }
    }
  ]
}
