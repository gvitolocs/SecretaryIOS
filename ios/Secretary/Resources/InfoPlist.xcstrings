{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Camera permission: face tracking and AR for Lucina, photos and videos for the chat, QR sign-in codes.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucina mirrors your face or appears in your room when you turn it on, you can take photos and videos to send her in the chat, and you can scan a QR code to sign in another device. Nothing leaves this iPhone unless you send it."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucina imita il tuo viso o compare nella tua stanza quando lo attivi, puoi scattare foto e video da mandarle in chat e inquadrare un codice QR per far accedere un altro dispositivo. Niente lascia questo iPhone se non lo invii tu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lucina spejler dit ansigt eller dukker op i dit rum, når du slår det til, du kan tage billeder og videoer og sende dem til hende i chatten, og du kan scanne en QR-kode for at logge en anden enhed ind. Intet forlader denne iPhone, medmindre du sender det."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "comment": "Face ID permission: signing a sensitive owner approval.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Secretary asks for Face ID before it approves a sensitive request for you, like revealing a secret or running a command as root."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Secretary chiede Face ID prima di approvare per te una richiesta delicata, come rivelare un segreto o eseguire un comando come root."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Secretary beder om Face ID, før den godkender en følsom anmodning for dig, som at afsløre en hemmelighed eller køre en kommando som root."
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "Add-only photo permission: saving a chat photo.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Photos Lucina's chat shows you are saved to your library when you tap Save."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le foto della chat con Lucina vengono salvate nella tua libreria quando tocchi Salva."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder fra chatten med Lucina gemmes i dit bibliotek, når du trykker på Gem."
          }
        }
      }
    }
  },
  "version": "1.0"
}
