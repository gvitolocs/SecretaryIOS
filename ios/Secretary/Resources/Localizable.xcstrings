          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando Lucina o qualcun altro modifica una lista della spesa."
          }
        }
      }
    },
    "When Lucina wants to do something on your iPhone that needs a tap." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Når Lucina vil gøre noget på din iPhone, der kræver et tryk."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando Lucina vuole fare qualcosa sull'iPhone che richiede un tocco."
