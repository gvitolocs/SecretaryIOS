    "Weight from Apple Health goes to the Weight tab, your gym workouts go to Health, and Lucina gets a daily summary (steps, sleep, workouts)." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vægt fra Apple Sundhed går til fanen Vægt, dine træninger går til Sundhed, og Lucina får et dagligt resumé (skridt, søvn, træninger)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il peso da Apple Salute va nella scheda Peso, i tuoi allenamenti vanno in Salute e Lucina riceve un riepilogo giornaliero (passi, sonno, allenamenti)."
          }
        }
      }
    },
    "Weight trend with the 7-day average" : {
