    "iOS can't decide while a call rings, so only numbers already above these limits are blocked. Contacts and numbers you allow never are." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS non può decidere mentre una chiamata squilla, quindi si bloccano solo i numeri già oltre questi limiti. I contatti e i numeri che consenti non vengono mai bloccati."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS kan ikke afgøre noget, mens et opkald ringer, så kun numre, der allerede er over disse grænser, blokeres. Kontakter og numre, du tillader, blokeres aldrig."
          }
        }
      }
    },
    "Blocked" : {
      "localizations" : {
