    "Reminders and calendar events are scheduled on the iPhone, so they arrive even when Secretary is closed. Other notifications arrive when the app is open or refreshes in the background." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påmindelser og kalenderbegivenheder planlægges på iPhonen, så de kommer, også når Secretary er lukket. Andre notifikationer kommer, når appen er åben eller opdaterer i baggrunden."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria ed eventi del calendario sono programmati sull'iPhone, quindi arrivano anche con Secretary chiusa. Le altre notifiche arrivano quando l'app è aperta o si aggiorna in background."
          }
        }
      }
    },
    "Reminders still come through" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påmindelser kommer stadig igennem"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I promemoria arrivano comunque"
          }
        }
      }
    },
    "Reminders, the shopping list, errands. Messages from the web, Telegram, Discord and Alexa show up here too." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Påmindelser, indkøbslisten, ærinder. Beskeder fra web, Telegram, Discord og Alexa vises også her."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Promemoria, lista della spesa, commissioni. Qui compaiono anche i messaggi dal web, Telegram, Discord e Alexa."
          }
        }
      }
    },
    "Remote MCP server, saved for Lucina. Nothing is called yet." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern MCP-server, gemt til Lucina. Intet kaldes endnu."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Server MCP remoto, salvato per Lucina. Per ora non viene chiamato."
          }
        }
      }
    },
    "Remote push (APNs)" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fjern-push (APNs)"
          }
