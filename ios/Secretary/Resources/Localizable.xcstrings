{
  "sourceLanguage" : "en",
  "strings" : {
    "Face ID didn't confirm it. Nothing was sent. Tap Approve to try again." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID non l'ha confermato. Non è stato inviato nulla. Tocca Approva per riprovare."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID bekræftede det ikke. Intet blev sendt. Tryk på Godkend for at prøve igen."
          }
        }
      }
    },
