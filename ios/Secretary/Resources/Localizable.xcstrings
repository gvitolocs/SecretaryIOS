      }
    },
    "Off. Turn on Secretary under Settings › Phone › Call Blocking & Identification, so calls from numbers Lucina has screened show a label." : {
      "localizations" : {
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disattivate. Attiva Secretary in Impostazioni › Telefono › Blocco e identificazione chiamate, così le chiamate dai numeri controllati da Lucina mostrano un'etichetta."
          }
        },
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Slået fra. Slå Secretary til under Indstillinger › Telefon › Opkaldsblokering og -identifikation, så opkald fra numre, som Lucina har tjekket, viser en etiket."
          }
        }
      }
    },
