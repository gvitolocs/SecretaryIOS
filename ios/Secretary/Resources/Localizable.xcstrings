    },
    "What do you want to ask Lucina?" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad vil du spørge Lucina om?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa vuoi chiedere a Lucina?"
          }
        }
      }
    },
    "What should I add?" : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hvad skal jeg tilføje?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cosa devo aggiungere?"
          }
