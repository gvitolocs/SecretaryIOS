    "Tap her to say hi. Pinch to resize, twist to turn." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tryk på hende for at sige hej. Knib for at ændre størrelse, drej for at vende hende."
