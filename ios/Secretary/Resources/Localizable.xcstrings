    "Lucina can add and complete reminders and sees the upcoming ones. Deleting asks you first." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucina kan tilføje og fuldføre påmindelser og ser de kommende. Sletning spørger dig først."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucina può aggiungere e completare promemoria e vede quelli in arrivo. Per eliminarli ti chiede prima."
          }
        }
      }
    },
    "Lucina can recall it: ask her “what's in the note %@”." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucina kan finde den frem: spørg “hvad står der i noten %@”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucina la ritrova: chiedile “cosa c'è nella nota %@”."
          }
        }
      }
    },
    "Lucina can set and delete alarms and timers she made (Clock's own alarms are out of reach). Deleting asks you first." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucina kan sætte og slette alarmer og timere, hun har lavet (Urs egne alarmer kan hun ikke røre). Sletning spørger dig først."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucina può impostare ed eliminare le sveglie e i timer che ha creato (quelli dell'app Orologio restano fuori portata). Per eliminarli ti chiede prima."
          }
        }
      }
    },
