    "Lucina only sees and changes what you turn on here. Everything goes to your own server and Lucina, never to anyone else." : {
      "localizations" : {
        "da" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucina ser og ændrer kun det, du slår til her. Alt går til din egen server og Lucina, aldrig til andre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lucina vede e cambia solo ciò che attivi qui. Tutto va al tuo server e a Lucina, mai a nessun altro."
          }
        }
      }
