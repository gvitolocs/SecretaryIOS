{
  "name": "secretary-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Secretary web frontend (SolidJS SPA) for secratary.app",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node mock/dev-mock.mjs",
    "mock": "node mock/server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource-variable/sora": "5.3.0",
    "@secretary/lucina-stage": "file:../packages/lucina-stage",
    "@solidjs/router": "1.0.0",
    "solid-js": "1.9.16",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@solidjs/testing-library": "0.8.10",
    "@testing-library/jest-dom": "7.0.1",
    "@types/node": "22.20.5",
    "@types/three": "0.186.0",
    "jsdom": "30.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.2",
    "vite-plugin-solid": "2.11.14",
    "vitest": "5.0.3"
  },
  "engines": {
    "node": ">=22.22.2"
  },
  "overrides": {
    "babel-preset-solid": "1.9.16",
    "babel-plugin-jsx-dom-expressions": "0.40.11"
  }
