# ~/.config/secretary-pixiv/pixiv.env (0600). No secrets in this file: only paths to them.
# nezopt's tailnet address so p1's Caddy can reach it; never a public interface.
PIXIV_BIND=100.107.164.33:8872
PIXIV_DATA_DIR=/home/nez/.local/share/secretary-pixiv
# Cache of JSON answers and proxied images; oldest-used entries go first above the cap (bytes).
PIXIV_CACHE_DIR=/home/nez/.local/share/secretary-pixiv/cache
PIXIV_CACHE_MAX_BYTES=2147483648
# Originals wait here (0700) until lucina-media's loopback ingest takes them.
PIXIV_SPOOL_DIR=/home/nez/.local/share/secretary-pixiv/spool
PIXIV_MEDIA_URL=http://127.0.0.1:8830
PIXIV_OWNER=owner
# 32+ random bytes, the same value p1's Caddy sends as X-Lucina-Gateway
# (p1: /etc/caddy/pixiv-gateway.key):
#   head -c 32 /dev/urandom | base64 > ~/.config/secretary-pixiv/gateway.secret; chmod 600 ...
PIXIV_GATEWAY_SECRET_FILE=/home/nez/.config/secretary-pixiv/gateway.secret
# Spacing between requests to pixiv.net, ms (never below 1000). One request at a time.
PIXIV_API_INTERVAL_MS=1500
# i.pximg.net thumbnails: request starts spaced by this (never below 100 ms), up to N at once.
PIXIV_IMAGE_INTERVAL_MS=250
PIXIV_IMAGE_CONCURRENCY=3
PIXIV_LIST_TTL_SECS=300
PIXIV_ILLUST_TTL_SECS=1800
