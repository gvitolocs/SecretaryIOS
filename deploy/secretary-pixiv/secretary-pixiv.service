[Unit]
Description=Pixiv plugin (secretary-pixiv): ranking, search, work pages, signed image proxy, bookmarks, save to gallery (127.0.0.1 + tailnet :8872)
Documentation=file:///home/nez/Projects/Lucina/SecretaryIOS/docs/pixiv.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/secretary-pixiv/pixiv.env
Environment=RUST_LOG=info
ExecStart=%h/.local/bin/secretary-pixiv
# Graceful stop: the binary handles SIGTERM (axum graceful shutdown); a SIGKILL after the timeout
# means it hung and should alert the owner.
KillSignal=SIGTERM
TimeoutStopSec=20
Restart=on-failure
RestartSec=10
UMask=0077
MemoryHigh=384M
MemoryMax=768M
NoNewPrivileges=yes
Nice=5

[Install]
WantedBy=default.target
