[Unit]
Description=JEV routing drift report (journal, labelled replay, one ops record)
After=lucina-rs.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/lucina-rs/lucina.env
EnvironmentFile=%h/.config/lucina-rs/mode.env
ExecStart=%h/.local/bin/lucina-rs jev drift-report --days 7
Nice=10
CPUQuota=50%
MemoryMax=256M
