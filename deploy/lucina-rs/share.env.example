# Append to ~/.config/lucina-rs/mode.env on nezopt after provisioning the
# matching p1 Caddy key. Unset LUCINA_SHARE_GATEWAY_KEY_FILE keeps sharing off.
LUCINA_SHARE_GATEWAY_KEY_FILE=/home/nez/.config/lucina-rs/share-gateway.key
LUCINA_SHARE_DIR=/home/nez/data/lucina-share
LUCINA_MEDIA_INTERNAL_URL=http://127.0.0.1:8830
LUCINA_VISION_SERVER_BIN=/home/nez/llama.cpp/build/bin/llama-server
LUCINA_VISION_MODEL=/home/nez/models/gemma-4-12b-it-qat/gemma-4-12b-it-qat-q4_0.gguf
LUCINA_VISION_MMPROJ=/home/nez/models/gemma-4-12b-it-qat/mmproj-gemma-4-12b-it-qat-q4_0.gguf
LUCINA_WHISPER_BIN=/home/nez/Projects/whisper.cpp/build/bin/whisper-cli
LUCINA_WHISPER_MODEL=/home/nez/models/whisper/ggml-large-v3.bin
# Optional: use an externally managed vision endpoint; otherwise Lucina
# starts/stops her own leased vision process.
# LUCINA_VISION_URL=http://127.0.0.1:18830
