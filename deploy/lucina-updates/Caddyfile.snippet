# PROPOSAL (JD-C008), not applied. p1 (getsecretary.tech), inside the site block, BEFORE the catch-all
# `handle`. lucina-updates (crates/lucina-updates) serves the signed manifest and the artefacts of each
# product channel, read-only and keyless; a device verifies everything itself, so this block only
# keeps the code private (device auth) and delivers big files cheaply.
#
# The sidecar listens on loopback of nezopt (127.0.0.1:8811), not on the tailnet address like
# lucina-media, so p1 needs a path to it (the coordinator's choice: a tailnet-only second listener,
# or a forward). UPDATES_UPSTREAM below is that address.
@updates path /v1/updates/*
handle @updates {
	route {
		# Read-only: anything but GET and HEAD stops here (the sidecar also answers 405).
		@updates_write not method GET HEAD
		respond @updates_write `{"ok":false,"error":"method_not_allowed"}` 405
		# Same device check as /v1/media, its own rate bucket (secretary-server /v1/auth/updates).
		forward_auth 127.0.0.1:8800 {
			uri /v1/auth/updates
		}
		# Nothing is uploaded here.
		request_body {
			max_size 1KiB
		}
		reverse_proxy UPDATES_UPSTREAM {
			# Large artefacts and Range requests stream through: no buffering, no read deadline
			# for a slow phone.
			flush_interval -1
			transport http {
				response_header_timeout 30s
				read_timeout 0
				write_timeout 0
			}
			header_up -Authorization
			header_up -Cookie
		}
	}
}
