# Self-hosted maps for the Secretary apps (crates/secretary-maps/README.md): PMTiles with HTTP
# range, map fonts and sprites, geocoding through the local Photon. User unit on nezopt:
#   install -m 0755 target/release/secretary-maps ~/.local/bin/
#   cp deploy/secretary-maps.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now secretary-maps
#
# Configuration in ~/.config/secretary-maps/env (MAPS_BIND=100.107.164.33:8840, MAPS_HOME_*,
# MAPS_UPSTREAM_KEY_FILE, ...). It listens on the tailnet address only. ufw does not filter
# tailnet traffic on nezopt, so every route but /health also requires the key p1's Caddy sends
# (X-Maps-Upstream-Key).
[Unit]
Description=Secretary maps (tiles, fonts, sprites, geocoder) on 100.107.164.33:8840
After=network-online.target tailscaled.service

[Service]
Type=simple
EnvironmentFile=%h/.config/secretary-maps/env
Environment=MAPS_DIR=%h/data/maps
ExecStart=%h/.local/bin/secretary-maps
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes

[Install]
WantedBy=default.target
