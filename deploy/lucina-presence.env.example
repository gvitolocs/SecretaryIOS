# ~/.config/lucina/presence.env (mode 0600) for lucina-presence.service
LUCINA_OWNER_DISCORD_USER_ID=649020113026023475
LUCINA_DATA_DIR=/home/nez/Projects/Lucina/data
# 0600 file with the Lucina bot token, made without printing it:
#   (umask 077; docker exec lucina-nez printenv DISCORD_BOT_TOKEN_LUCINA > ~/.config/lucina/discord-token)
LUCINA_DISCORD_TOKEN_FILE=/home/nez/.config/lucina/discord-token
LUCINA_PRESENCE_RETENTION_DAYS=90
RUST_LOG=info
