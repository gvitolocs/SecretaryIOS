[Unit]
Description=Lucina (Rust): /api/secretary side by side with the Node Lucina (shadow until cutover)
Documentation=file:///home/nez/Projects/SecretaryIOS-lucina/docs/lucina-rust/PHASE1.md
After=network-online.target
Wants=network-online.target
# Binding the Tailscale address fails until tailscale0 is up: retry, but not forever.
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=%h/Projects/Lucina
# The live Node Lucina's settings (generated by `lucina-rs env-from-node`,
# values never printed), then the mode (shadow.env or cutover.env), which wins.
EnvironmentFile=%h/.config/lucina-rs/node.env
EnvironmentFile=%h/.config/lucina-rs/mode.env
Environment=RUST_LOG=info
ExecStart=%h/.local/bin/lucina-rs serve
# Health gate: the unit is only "started" once /health answers.
ExecStartPost=/bin/sh -c 'for i in $(seq 1 40); do curl -fsS -m 3 -o /dev/null http://127.0.0.1:8790/health && exit 0; sleep 0.5; done; echo "lucina-rs: /health did not answer" >&2; exit 1'
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=15
UMask=0077
MemoryHigh=384M
MemoryMax=768M
NoNewPrivileges=yes

[Install]
WantedBy=default.target
