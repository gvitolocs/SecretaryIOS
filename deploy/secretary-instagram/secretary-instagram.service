[Unit]
Description=Instagram plugin (secretary-instagram): profiles, stories, highlights, posts, reels, signed media proxy, save to Lucina (127.0.0.1 + tailnet :8871)
Documentation=file:///home/nez/Projects/Lucina/SecretaryIOS/docs/instagram.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/secretary-instagram/instagram.env
Environment=RUST_LOG=info
ExecStart=%h/.local/bin/secretary-instagram
# Graceful stop: the service handles SIGTERM, finishes the requests in flight and exits 0.
# A SIGKILL alerts the owner, so give it time (a video download can be in flight).
KillSignal=SIGTERM
TimeoutStopSec=30
SendSIGKILL=yes
Restart=on-failure
RestartSec=10
UMask=0077
MemoryHigh=256M
MemoryMax=512M
NoNewPrivileges=yes
Nice=5

[Install]
WantedBy=default.target
