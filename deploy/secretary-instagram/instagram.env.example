# ~/.config/secretary-instagram/instagram.env (0600). No secrets in this file: only paths to them.
# nezopt's tailnet address so p1's Caddy can reach it; never a public interface.
INSTAGRAM_BIND=100.x.y.z:8871
INSTAGRAM_DATA_DIR=/home/nez/.local/share/secretary-instagram
# 32+ random bytes, the same value p1's Caddy sends as X-Lucina-Gateway:
#   head -c 32 /dev/urandom | base64 > ~/.config/secretary-instagram/gateway.secret; chmod 600 ...
INSTAGRAM_GATEWAY_SECRET_FILE=/home/nez/.config/secretary-instagram/gateway.secret
# Disk cache (default $INSTAGRAM_DATA_DIR/cache) and its cap in bytes (default 2 GiB); oldest files go first.
#INSTAGRAM_CACHE_DIR=/home/nez/.local/share/secretary-instagram/cache
INSTAGRAM_CACHE_MAX_BYTES=2147483648
# Spacing between requests to the StoryView backend, ms (never below 1000), and to the Instagram CDN.
INSTAGRAM_API_INTERVAL_MS=1000
INSTAGRAM_MEDIA_INTERVAL_MS=250
# lucina-media's loopback ingest (Save to Lucina).
INSTAGRAM_INGEST_URL=http://127.0.0.1:8830
