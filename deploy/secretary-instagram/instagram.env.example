# ~/.config/secretary-instagram/instagram.env (0600). No secrets in this file: only paths to them.
# nezopt's tailnet address so p1's Caddy can reach it; never a public interface.
INSTAGRAM_BIND=100.x.y.z:8871
INSTAGRAM_DATA_DIR=/home/nez/.local/share/secretary-instagram
# 32+ random bytes, the same value p1's Caddy sends as X-Lucina-Gateway:
#   head -c 32 /dev/urandom | base64 > ~/.config/secretary-instagram/gateway.secret; chmod 600 ...
INSTAGRAM_GATEWAY_SECRET_FILE=/home/nez/.config/secretary-instagram/gateway.secret
# Disk cache: the profile store, JSON and media (docs/instagram.md, "Local first"). On the big disk; the directory must
# exist (make it by hand): if it is missing, the service uses $INSTAGRAM_DATA_DIR/cache with a 2 GiB cap.
# Oldest files go first; watched accounts and saved items stay.
INSTAGRAM_CACHE_DIR=/home/nez/mnt/mybook/secretary-instagram-cache
INSTAGRAM_CACHE_MAX_BYTES=214748364800
# The slow background download: rest between files, bytes per UTC day; older pages from the backend: rest, calls per UTC day.
#INSTAGRAM_MIRROR=1
#INSTAGRAM_MIRROR_INTERVAL_MS=1000
#INSTAGRAM_MIRROR_DAILY_MAX_BYTES=21474836480
#INSTAGRAM_BACKFILL_INTERVAL_SECS=20
#INSTAGRAM_BACKFILL_DAILY_CALLS=300
# Spacing between requests to the StoryView backend, ms (never below 1000), and to the Instagram CDN.
INSTAGRAM_API_INTERVAL_MS=1000
INSTAGRAM_MEDIA_INTERVAL_MS=250
# lucina-media's loopback ingest (Save to Lucina).
INSTAGRAM_INGEST_URL=http://127.0.0.1:8830

# Watching (docs/instagram.md): the warmer refreshes each watched account about once a day (every
# INSTAGRAM_WATCH_INTERVAL_H hours, 1-23, ± 30 min random), auto-saves its new stories to the Gallery and
# tells the owner when it goes private/public/away. The owner's choice in the app (6, 12 or 23 h) wins.
#INSTAGRAM_WATCH=1
#INSTAGRAM_WATCH_INTERVAL_H=23
# How long the warmer stays quiet after the backend says 429.
#INSTAGRAM_WATCH_PAUSE_SECS=1800
# Auto-saved bytes per account per UTC day (500 MiB).
#INSTAGRAM_WATCH_DAILY_MAX_BYTES=524288000
# Owner notifications through secretary-server (POST /v1/notify, like lucina-meshy). The token is Lucina's
# svc_ service token in a 0600 file (from the Infisical broker; never in this file or in git).
#INSTAGRAM_NOTIFY_URL=https://getsecretary.tech
#INSTAGRAM_NOTIFY_TOKEN_FILE=/home/nez/.config/secretary-instagram/notify.token
