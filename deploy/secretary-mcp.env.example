# /etc/secretary-mcp/secretary-mcp.env  (root:secretary-mcp 0640; contains no secrets)
SECRETARY_MCP_BIND=127.0.0.1:8810
# OAuth issuer; the MCP endpoint is <this>/mcp
SECRETARY_MCP_PUBLIC_URL=https://getsecretary.tech
SECRETARY_MCP_DATA_DIR=/var/lib/secretary-mcp
SECRETARY_MCP_BACKEND_URL=http://127.0.0.1:8800
# A secretary-server device token (sec_…) named lucina-mcp, one line, secretary-mcp:secretary-mcp 0600
SECRETARY_MCP_BACKEND_TOKEN_FILE=/etc/secretary-mcp/backend.token
# Optional: secretary-server's service token (svc_…) for GET /v1/insights/summary (gym_summary).
# Without it gym_summary reads /v1/gym/state instead.
#SECRETARY_MCP_SERVICE_TOKEN_FILE=/etc/secretary-mcp/service.token
SECRETARY_MCP_TIMEZONE=Europe/Rome
# Caddy is in front: client IP from the right-most X-Forwarded-For (login rate limit)
SECRETARY_MCP_TRUST_PROXY=1
# OAuth redirect_uris allowed (exact URLs, or prefixes ending in /). Default: ChatGPT's two callbacks.
#SECRETARY_MCP_OAUTH_REDIRECTS=https://chatgpt.com/connector_platform_oauth_redirect,https://chatgpt.com/connector/oauth/
# Client ID Metadata Document URL prefixes (empty value: CIMD off, DCR only). Default: ChatGPT's.
#SECRETARY_MCP_OAUTH_CIMD=https://chatgpt.com/oauth/
#SECRETARY_MCP_ACCESS_TTL_SECS=3600
#SECRETARY_MCP_REFRESH_TTL_SECS=2592000
#SECRETARY_MCP_ALLOWED_HOSTS=getsecretary.tech,localhost,127.0.0.1
#SECRETARY_MCP_ALLOWED_ORIGINS=https://getsecretary.tech:443,https://chatgpt.com:443,https://claude.ai:443
# Optional: GET /internal/status for the app's Links tab (same content as secretary-server's mcp-status.token)
#SECRETARY_MCP_STATUS_TOKEN_FILE=/etc/secretary-mcp/status.token
RUST_LOG=secretary_mcp=info,rmcp=warn
