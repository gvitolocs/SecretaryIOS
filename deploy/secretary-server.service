# /etc/systemd/system/secretary-server.service
[Unit]
Description=Secretary gateway (iOS/web app <-> Lucina)
Documentation=file:///opt/secretary/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=secretary
Group=secretary
ExecStart=/usr/local/bin/secretary-server serve
EnvironmentFile=/etc/secretary/secretary.env
# /var/lib/secretary: devices.json, sessions.json, web/ (the built web app)
StateDirectory=secretary
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=20s

# Resources (the VM has 1 GB)
MemoryMax=128M
TasksMax=256

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
