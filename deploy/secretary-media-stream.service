# Provisional media library for the Secretary players (docs/media-player.md): folders on
# nezopt served with the secretary-media-stream routes until lucina-media takes over the
# same port and routes. User unit on nezopt:
#   install -m 0755 target/release/secretary-media-stream ~/.local/bin/
#   cp deploy/secretary-media-stream.service ~/.config/systemd/user/
#   systemctl --user daemon-reload && systemctl --user enable --now secretary-media-stream
#
# Listens on the tailnet address only. ufw does not filter tailnet traffic on nezopt, so the
# non-token routes also require the key p1's Caddy sends (X-Media-Upstream-Key).
[Unit]
Description=Secretary media stream (provisional library) on 100.107.164.33:8830
After=network-online.target tailscaled.service

[Service]
Type=simple
ExecStart=%h/.local/bin/secretary-media-stream --listen 100.107.164.33:8830 \
  --root "Film=%h/Videos/movies" \
  --root "Dansk film=%h/mnt/mybook/Data/dansk_filmer" \
  --root "Lyd=%h/data/media-stream/library/lyd" \
  --root "Video=%h/data/media-stream/library/video" \
  --cache %h/data/media-stream/cache \
  --progress %h/data/media-stream/progress.json \
  --secret-file %h/.config/secretary-media/play-token.key \
  --upstream-key-file %h/.config/secretary-media/upstream.key
Restart=on-failure
RestartSec=5
UMask=0077
# ffmpeg transcodes run at low priority next to the rest of the box.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

[Install]
WantedBy=default.target
