# /etc/systemd/system/secretary-mcp.service
[Unit]
Description=Lucina MCP (remote MCP server for Claude Code, ChatGPT, Grok)
Documentation=file:///opt/secretary/MCP.md
After=network-online.target secretary-server.service
Wants=network-online.target

[Service]
Type=simple
User=secretary-mcp
Group=secretary-mcp
ExecStart=/usr/local/bin/secretary-mcp serve
EnvironmentFile=/etc/secretary-mcp/secretary-mcp.env
# /var/lib/secretary-mcp: tokens.json, oauth.json (0600, hashes only)
StateDirectory=secretary-mcp
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=2s
KillSignal=SIGTERM
TimeoutStopSec=15s

# Resources (the VM has 1 GB)
MemoryMax=96M
TasksMax=128

# Hardening (same as secretary-server). Outbound HTTPS stays open: the
# OAuth server fetches ChatGPT's client metadata document
# (https://chatgpt.com/oauth/client.json).
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged

[Install]
WantedBy=multi-user.target
