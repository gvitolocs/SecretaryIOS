[Unit]
Description=Reader plugin (secretary-nclient): search, detail, image proxy, favorites; child-safety filter (127.0.0.1 + tailnet :8870)
Documentation=file:///home/nez/Projects/SecretaryIOS/docs/nclient.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=%h/.config/secretary-nclient/nclient.env
Environment=RUST_LOG=info
ExecStart=%h/.local/bin/secretary-nclient
Restart=on-failure
RestartSec=10
UMask=0077
MemoryHigh=256M
MemoryMax=512M
NoNewPrivileges=yes
Nice=5

[Install]
WantedBy=default.target
