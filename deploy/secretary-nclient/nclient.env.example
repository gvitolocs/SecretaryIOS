# ~/.config/secretary-nclient/nclient.env (0600). No secrets in this file: only paths to them.
# nezopt's tailnet address so p1's Caddy can reach it; never a public interface.
NCLIENT_BIND=100.x.y.z:8870
NCLIENT_HOST=nhentai.net
NCLIENT_DATA_DIR=/home/nez/.local/share/secretary-nclient
NCLIENT_OWNER=owner
# 32+ random bytes, the same value p1's Caddy sends as X-Lucina-Gateway:
#   head -c 32 /dev/urandom | base64 > ~/.config/secretary-nclient/gateway.secret; chmod 600 ...
NCLIENT_GATEWAY_SECRET_FILE=/home/nez/.config/secretary-nclient/gateway.secret
# Optional: a Cookie header (Cloudflare clearance) if the site starts answering 403.
#NCLIENT_COOKIE_FILE=/home/nez/.config/secretary-nclient/cookie
# Spacing between requests to the site, ms (never below 1000).
NCLIENT_API_INTERVAL_MS=1000
NCLIENT_IMAGE_INTERVAL_MS=1000
# Cap on the cache directory (vetted JSON + proxied images); the oldest files go first. 0 = no cap.
#NCLIENT_CACHE_MAX_BYTES=2147483648
# "Save to Lucina": pages wait here until lucina-media's loopback ingest takes them (emptied at start),
# and the ingest address (must be loopback).
#NCLIENT_SPOOL_DIR=/home/nez/.local/share/secretary-nclient/spool
#NCLIENT_MEDIA_URL=http://127.0.0.1:8830
