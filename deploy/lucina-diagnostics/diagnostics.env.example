# lucina-diagnostics (crates/lucina-diagnostics, docs/diagnostics.md). Secrets are files, never values here.
LUCINA_DIAGNOSTICS_DIR=/home/nez/data/lucina-diagnostics
# 127.0.0.1 for Lucina; the tailnet address for p1's Caddy (/v1/diagnostics*) and secretary-mcp on p1.
LUCINA_DIAGNOSTICS_BIND=127.0.0.1:8850,@TAILNET@:8850
# Caddy on p1 adds X-Diagnostics-Gateway: <this> after forward_auth (= p1 /etc/caddy/diagnostics-gateway.key).
LUCINA_DIAGNOSTICS_GATEWAY_TOKEN_FILE=/home/nez/.config/lucina-diagnostics/gateway.token
# Bearer for local callers: Lucina (LUCINA_DIAGNOSTICS_SERVICE_TOKEN_FILE), secretary-mcp, the servers.
LUCINA_DIAGNOSTICS_SERVICE_TOKEN_FILE=/home/nez/.config/lucina-diagnostics/service.token
LUCINA_DIAGNOSTICS_TIMEZONE=Europe/Copenhagen
LUCINA_DIAGNOSTICS_RETENTION_DAYS=90
# Caps: request body (report + attachments as uploaded), attachments after gzip, files per report.
LUCINA_DIAGNOSTICS_MAX_UPLOAD_MB=20
LUCINA_DIAGNOSTICS_MAX_EXPANDED_MB=64
LUCINA_DIAGNOSTICS_MAX_FILES=10
# Per device (app + device name): burst, then this many an hour; and all devices together.
LUCINA_DIAGNOSTICS_RATE_BURST=20
LUCINA_DIAGNOSTICS_RATE_PER_HOUR=60
LUCINA_DIAGNOSTICS_GLOBAL_PER_HOUR=600
# New crash / fatal_error signatures notify the owner (app inbox + Telegram, as memos), at most this many an hour.
LUCINA_DIAGNOSTICS_NOTIFY_PER_HOUR=4
TELEGRAM_BOT_TOKEN_LUCINA_FILE=/home/nez/.config/lucina-rs/telegram-bot-token-lucina.token
#LUCINA_DIAGNOSTICS_NOTIFY_TELEGRAM=off
#LUCINA_DIAGNOSTICS_NOTIFY_APP=off
#LUCINA_DIAGNOSTICS_TELEGRAM_CHAT_ID=
