[Unit]
Description=Lucina diagnostics: crash reports and logs from every client (127.0.0.1 + tailnet :8850)
Documentation=file:///home/nez/Projects/SecretaryIOS/docs/diagnostics.md
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h
# LUCINA_SECRETARY_SERVER_URL, LUCINA_SECRETARY_SERVICE_TOKEN_FILE, TELEGRAM_ALLOWED_CHAT_IDS
# (crash notifications) come from Lucina's generated env; diagnostics.env is this service's own.
EnvironmentFile=-%h/.config/lucina-rs/node.env
EnvironmentFile=%h/.config/lucina-diagnostics/diagnostics.env
Environment=RUST_LOG=info
ExecStart=%h/.local/bin/lucina-diagnostics serve
ExecStartPost=/bin/sh -c 'for i in $(seq 1 40); do curl -fsS -m 3 -o /dev/null http://127.0.0.1:8850/health && exit 0; sleep 0.5; done; echo "lucina-diagnostics: /health did not answer" >&2; exit 1'
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=30
UMask=0077
MemoryHigh=512M
MemoryMax=1G
NoNewPrivileges=yes
Nice=5

[Install]
WantedBy=default.target
