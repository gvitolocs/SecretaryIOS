# lucina-memo (crates/lucina-memo, docs/memos.md). Secrets are files, never values here.
LUCINA_MEMO_DIR=/home/nez/Projects/Lucina/data/memos
LUCINA_MEMO_BIND=127.0.0.1:8795,@TAILNET@:8795
LUCINA_MEMO_GATEWAY_TOKEN_FILE=/home/nez/.config/lucina-memo/gateway.token
LUCINA_MEMO_SERVICE_TOKEN_FILE=/home/nez/.config/lucina-memo/service.token
LUCINA_MEMO_PUBLIC_URL=https://getsecretary.tech
LUCINA_MEMO_TIMEZONE=Europe/Copenhagen
# whisper.cpp (the gpu-lease shim), large-v3 on the RX 7900 XTX; CPU fallback only if the model exists.
#LUCINA_MEMO_WHISPER_MODEL=/home/nez/models/whisper/ggml-large-v3.bin
#LUCINA_MEMO_WHISPER_CPU_MODEL=/home/nez/models/whisper/ggml-large-v3-turbo-q8_0.bin
LUCINA_MEMO_WHISPER_VAD_MODEL=/home/nez/Projects/whisper.cpp/models/for-tests-silero-v6.2.0-ggml.bin
LUCINA_MEMO_GPU_WAIT_SEC=900
#LUCINA_MEMO_LANGUAGE=auto
# Obsidian: the canonical vault on the Pi (ssh alias pi-cursor = nes@pi). "off" disables.
LUCINA_MEMO_OBSIDIAN_VAULT=pi-cursor:/home/nes/Obsidian
#LUCINA_MEMO_OBSIDIAN_FOLDER=Voice Memos/Lucina
# Notifications: app inbox (LUCINA_SECRETARY_SERVER_URL + service token from lucina.env) and Telegram.
TELEGRAM_BOT_TOKEN_LUCINA_FILE=/home/nez/.config/lucina-rs/telegram-bot-token-lucina.token
#LUCINA_MEMO_NOTIFY_TELEGRAM=off
#LUCINA_MEMO_NOTIFY_APP=off

# Optional: secretary-maps (local Photon) to prefer the calendar event held where the phone was.
# LUCINA_MEMO_GEOCODE_URL=http://127.0.0.1:<port>

# ---- Meetings (docs/meetings.md) and speaker diarization (memos too) ----
# The archive on the MyBook; it must exist (install.sh creates it only when the disk is mounted).
LUCINA_MEETINGS_DIR=/home/nez/mnt/mybook/lucina-meetings
#LUCINA_MEETINGS_OBSIDIAN_FOLDER=Meetings
LUCINA_OWNER_NAME=Giuseppe
# Company names from attendees' e-mail domains skip these (comma-separated).
#LUCINA_MEETINGS_OWN_DOMAINS=post.au.dk,au.dk
# Lucina's memory entry per meeting: only "readwrite" writes (default: LUCINA_MEMORY_MODE, else off).
#LUCINA_MEETINGS_MEMORY_MODE=readwrite
# Diarization models and ONNX Runtime (one-time download: docs/meetings.md). "off" disables.
#LUCINA_DIARIZE=off
LUCINA_DIARIZE_MODELS=/home/nez/models/diarization
#LUCINA_DIARIZE_SEGMENTATION_MODEL=/home/nez/models/diarization/sherpa-onnx-pyannote-segmentation-3-0/model.onnx
#LUCINA_DIARIZE_EMBEDDING_MODEL=/home/nez/models/diarization/wespeaker_en_voxceleb_resnet34_LM.onnx
#LUCINA_DIARIZE_ORT_LIB=/home/nez/models/diarization/onnxruntime/lib/libonnxruntime.so
#LUCINA_DIARIZE_THREADS=4
#LUCINA_DIARIZE_STEP_SEC=2
#LUCINA_DIARIZE_CLUSTER_THRESHOLD=0.6
# Voice profiles (embeddings, 0600) and matching.
#LUCINA_VOICES_FILE=/home/nez/Projects/Lucina/data/memos/voices.json
#LUCINA_VOICE_MATCH_THRESHOLD=0.6
#LUCINA_VOICE_ASK_AFTER=2
