# /etc/secretary/secretary.env  (root:secretary 0640; contains no secrets)
SECRETARY_BIND=127.0.0.1:8800
# Lucina via the SSH relay to nezopt :8788
SECRETARY_LUCINA_URL=http://127.0.0.1:18788
# Lucina's SECRETARY_API_TOKEN, one line, secretary:secretary 0600
SECRETARY_LUCINA_TOKEN_FILE=/etc/secretary/lucina.token
SECRETARY_DATA_DIR=/var/lib/secretary
# Built web app (SolidJS dist/); unset to serve the API only
SECRETARY_WEB_DIR=/var/lib/secretary/web
# Caddy is in front: take the client IP from X-Forwarded-For
SECRETARY_TRUST_PROXY=1
RUST_LOG=secretary_server=info
# Optional: old shopping upstream routes under /v1/upstream/
#SECRETARY_UPSTREAM_LEGACY=https://api.getbring.com/rest
#SECRETARY_UPSTREAM_SERVICES=https://production.bringapi.app
#SECRETARY_UPSTREAM_CATALOG=/var/lib/secretary/catalog.json
# Optional: service token for Lucina (GET /v1/insights/summary), one line, secretary:secretary 0600.
# Create it with: secretary-server service-token generate /etc/secretary/service.token
#SECRETARY_SERVICE_TOKEN_FILE=/etc/secretary/service.token
# Optional: private avatar files for GET /v1/assets/{name} (authenticated only)
#SECRETARY_PRIVATE_ASSETS_DIR=/var/lib/secretary/private-assets
# Kokoro TTS (OpenAI-compatible) for POST /v1/tts, over Tailscale
#SECRETARY_TTS_URL=http://100.107.164.33:8880
#SECRETARY_TTS_VOICES=if_sara,af_heart,af_bella,bf_emma
# Shopping catalog files catalog.{it,en,da}.json for GET /v1/shopping/catalog
#SECRETARY_CATALOG_DIR=/var/lib/secretary/catalog
# POST /v1/device/events per device per minute (separate from the general 60/min)
#SECRETARY_DEVICE_EVENTS_PER_MINUTE=120
# Notifications (docs/notifications.md). VAPID keys are generated into the data dir
# (vapid.json, 0600) on first start; Lucina posts to /v1/notify with the service token above.
#SECRETARY_NOTIFY_INGEST=1
#SECRETARY_VAPID_SUBJECT=https://getsecretary.tech
#SECRETARY_PUSH_HOSTS=fcm.googleapis.com,push.services.mozilla.com,push.apple.com,notify.windows.com
# APNs for the native app: only with a paid Apple developer team (all three or none)
#SECRETARY_APNS_KEY_FILE=/etc/secretary/AuthKey_XXXXXXXXXX.p8
#SECRETARY_APNS_KEY_ID=XXXXXXXXXX
#SECRETARY_APNS_TEAM_ID=XXXXXXXXXX
#SECRETARY_APNS_TOPIC=tech.getsecretary.app
#SECRETARY_APNS_ENV=sandbox
